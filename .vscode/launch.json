{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "VRPdvAPI (Go)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/VRPdvAPI/main.go",
            "cwd": "${workspaceFolder}/VRPdvAPI"
        },
        {
            "name": "VRCheckout (debug mode)",
            "type": "dart",
            "request": "launch",
            "cwd": "VRCheckout",
            "program": "lib/main.dart"
        },
        {
            "name": "VRCheckout (profile mode)",
            "type": "dart",
            "request": "launch",
            "cwd": "VRCheckout",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "VRCheckout (release mode)",
            "type": "dart",
            "request": "launch",
            "cwd": "VRCheckout",
            "program": "lib/main.dart",
            "flutterMode": "release"
        },
        {
            "name": "VRCheckout (driver)",
            "type": "dart",
            "request": "launch",
            "cwd": "VRCheckout",
            "program": "test_driver/app.dart"
        }
    ],
    "compounds": [
        {
            "name": "API + Checkout",
            "configurations": [
                "VRPdvAPI (Go)",
                "VRCheckout (debug mode)"
            ],
            "stopAll": false
        },
        {
            "name": "API + Checkout (driver)",
            "configurations": [
                "VRPdvAPI (Go)",
                "VRCheckout (driver)"
            ],
            "stopAll": false
        }
    ]
}
